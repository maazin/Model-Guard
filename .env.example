# Copy to .env for local overrides. Never commit real secrets.
MODELGUARD_ENV=local
# SQLite by default for `make dev`; docker-compose uses PostgreSQL.
MODELGUARD_DATABASE_URL=sqlite:///./modelguard.db
MODELGUARD_ARTIFACT_DIR=./artifacts
# rule_based (offline, default) | anthropic | openai
MODELGUARD_LLM_PROVIDER=rule_based
# Only needed when MODELGUARD_LLM_PROVIDER=anthropic (the copilot never sends loan rows).
ANTHROPIC_API_KEY=
MODELGUARD_ANTHROPIC_MODEL=claude-opus-5
# Bootstrap draws for confidence intervals (lower = faster demo).
MODELGUARD_N_BOOTSTRAP=300

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["modelguard_api.main:app", "--port", "8010"],
      "port": 8010
    },
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "VITE_API_PROXY=http://localhost:8010 npm --prefix apps/web run dev"],
      "port": 5173
    }
  ]
}
